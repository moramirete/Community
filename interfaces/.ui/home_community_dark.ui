        <property name="styleSheet">
         <string notr="true">QFrame#frame_sidebar {
	background-color: #2d2d44;
	border-right: 2px solid #9333EA;
}

QPushButton {
	text-align: left;
	padding-left: 15px;
	border: none;
	background-color: transparent;
	font-weight: bold;
	color: #9333EA;
	font-size: 12px;
	height: 35px;
}

QPushButton:hover {
	background-color: #3d3d54;
}

QPushButton#btn_tableros {
	background-color: #9333EA;
	color: white;
	border: 1px solid #9333EA;
	border-radius: 5px;
	margin: 5px 10px;
	padding-left: 10px;
}

QPushButton#btn_agenda {
	margin: 5px 10px;
	color: #ccc;
}

QPushButton#btn_crear {
	background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
		stop:0 #9333EA, 
		stop:1 #A855F7);
	color: white;
	text-align: center;
	border-radius: 8px;
	padding: 0px;
	margin: 10px;
	height: 40px;
	font-size: 11px;
}</string>
